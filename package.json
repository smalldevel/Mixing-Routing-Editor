{
  "name": "mixing-routing-editor",
  "version": "1.0.0",
  "description": "Kanal- und Routing-Planer für Digitalmischpulte",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "build": {
    "appId": "com.mixingrouting.editor",
    "productName": "Mixing Routing Editor",
    "files": [
      "main.js",
      "index.html",
      "icon.png"
    ],
    "win": {
      "target": "nsis",
      "icon": "icon.png"
    },
    "mac": {
      "target": "dmg",
      "icon": "icon.png"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "icon.png"
    }
  },
  "keywords": ["mixer", "routing", "audio", "behringer"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "electron": "^42.5.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {}
}
